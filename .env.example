# =====================================================================
# Ụm Bò Milk HR System — cấu hình môi trường (copy thành .env)
# KHÔNG commit file .env lên git.
# =====================================================================

NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# google = dữ liệu thật trên Google Sheets
# memory = dữ liệu mẫu trong RAM (chạy thử giao diện khi chưa cấu hình Google)
DATA_BACKEND=memory

# ---------- API ----------
API_PORT=4000
API_PUBLIC_ORIGIN=http://localhost:3000
# Chuỗi ngẫu nhiên >= 32 ký tự (vd: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Token nội bộ để worker gọi api
INTERNAL_API_TOKEN=change-me-internal-token-at-least-32-chars
COOKIE_SECURE=false

# ---------- Google: OAuth bằng Gmail riêng của hệ thống ----------
# Dùng cho cả Google Sheets và Google Drive (file thuộc sở hữu Gmail này).
# Tạo ở Google Cloud Console > APIs & Services > Credentials > OAuth client (Desktop app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Lấy bằng lệnh: pnpm google:auth
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---------- Google Sheets (điền sau khi chạy pnpm sheets:bootstrap) ----------
SHEET_ID_CORE=
SHEET_ID_HR=
SHEET_ID_SCHEDULE=
SHEET_ID_ATTENDANCE=
SHEET_ID_PAYROLL=
SHEET_ID_COMMS=
SHEET_ID_SYSTEM=

# ---------- Google Drive ----------
DRIVE_ROOT_FOLDER_ID=

# ---------- Lưu trữ cục bộ ----------
LOCAL_STORAGE_DIR=./storage
PHOTO_LOCAL_RETENTION_DAYS=30

# ---------- Cache ----------
CACHE_REFRESH_SECONDS=45

# ---------- Cảnh báo & Gửi Email Doanh Nghiệp (Gmail API OAuth2 / SMTP) ----------
EMAIL_ENABLED=true
EMAIL_FROM_NAME="Ụm Bò Milk HR"
EMAIL_FROM_ADDRESS="umbomilk.hrsystem@gmail.com"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Web ----------
NEXT_PUBLIC_API_BASE=/api
# Dùng 127.0.0.1 thay vì localhost (Node 22 phân giải localhost thành IPv6)
API_INTERNAL_URL=http://127.0.0.1:4000

# ---------- Cấu hình Thương hiệu & Tham số Hệ thống (Tùy chỉnh) ----------
APP_BRAND_NAME="ỤM BÒ MILK"
APP_SYSTEM_TITLE="Ụm Bò Milk — Hệ thống Quản trị Nhân sự"
APP_BRAND_SUBTITLE="HỆ THỐNG NHÂN SỰ"
APP_SHORT_CODE="UB"
APP_EMAIL_SUBJECT_PREFIX="[Ụm Bò Milk HR]"
APP_COMPANY_DOMAIN="umbomilk.vn"
APP_VENDOR_NAME="Auto Stack"
APP_VERSION="v5.1.0"
NEXT_PUBLIC_APP_BRAND_NAME="ỤM BÒ MILK"
NEXT_PUBLIC_APP_SYSTEM_TITLE="Ụm Bò Milk — Hệ thống Quản trị Nhân sự"
NEXT_PUBLIC_APP_BRAND_SUBTITLE="HỆ THỐNG NHÂN SỰ"
NEXT_PUBLIC_APP_SHORT_CODE="UB"
NEXT_PUBLIC_APP_EMAIL_SUBJECT_PREFIX="[Ụm Bò Milk HR]"
NEXT_PUBLIC_APP_VERSION="v5.1.0"
APP_PROBATION_CYCLE_DAYS=12
APP_PROBATION_WORK_DAYS=7
APP_PROBATION_OFF_DAYS=5
APP_SHIFT_SWAP_ALLOWANCE_VND=30000
# Mặc định cho Hồ sơ lương cá nhân (mỗi nhân sự vẫn được chỉnh riêng)
APP_PROBATION_SALARY_PERCENT=85
APP_STANDARD_WORK_DAYS=26
APP_STANDARD_HOURS_PER_DAY=8
APP_OT_MULTIPLIER=1.5
APP_GPS_DEFAULT_RADIUS_M=100
APP_GPS_DEFAULT_MAX_ACCURACY_M=80

# ---------- Production (docker compose) ----------
# Không cần tên miền: dùng IP tĩnh của máy chủ + sslip.io, ví dụ 34-123-45-67.sslip.io
PUBLIC_HOST=
